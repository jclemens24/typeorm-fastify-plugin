{
	"compilerOptions": {
		"lib": ["ES2022"],
		"outDir": "build",
		"target": "ES2022",
		"module": "Node16",
		"moduleResolution": "Node16",
		"emitDecoratorMetadata": true,
		"experimentalDecorators": true,
		"sourceMap": true,
		"noImplicitAny": true,
		"declaration": true,
		"declarationMap": true,
		"noFallthroughCasesInSwitch": true,
		"noImplicitReturns": true,
		"stripInternal": true,
		"pretty": true,
		"strictNullChecks": true,
		"noUnusedLocals": true,
		"skipLibCheck": true,
		"removeComments": true,
		"rootDir": "src"
	},
	"include": ["src/**/*"],
	"exclude": ["node_modules", "build"]
}
